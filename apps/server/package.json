{
  "name": "@narralume/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "gate:phase1-large-text": "tsx src/gates/phase1-large-text-gate.ts",
    "gate:p2-checkpoint-recovery": "tsx src/gates/p2-checkpoint-recovery-gate.ts",
    "gate:p2-real-chapter-jobs": "tsx src/gates/p2-real-chapter-jobs-gate.ts",
    "gate:p3-real-episode": "tsx src/gates/p3-real-episode-gate.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
